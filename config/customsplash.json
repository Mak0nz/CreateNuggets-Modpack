  // Custom Splash configuration.
  //
  // "splashes" lists the texts shown on the title screen. One entry is picked at
  // random each time the title screen is opened, and a higher "weight" is picked
  // more often. Comments like these are allowed anywhere in the file, so this
  // reference and the examples below can be kept for later.
  //
  // Fields - only "text" is required:
  //
  //   "text"        the splash text. Placeholders are filled in when it is drawn:
  //                 {player} {username} {date} {time} {mc_version} {mc}
  //                 {version} {mods} {mods_count}
  //   "weight"      relative chance, default 1.
  //   "color"       "#RRGGBB", a gradient "#RRGGBB,#RRGGBB" with two or more
  //                 stops, "rainbow", or "rainbow:<degrees per character>".
  //   "conditions"  every listed condition must match:
  //                 "time"     "day" or "night"
  //                 "date"     "MM-DD" or "MM-DD..MM-DD", may wrap the new year
  //                 "weekend"  true or false
  //                 "player"   list of usernames
  //                 "mods"     list of required mod ids
  //                 "chance"   0.0 to 1.0
  //
  // Examples - delete the leading "//" to enable one:
  //
  //   { "text": "Hello, {player}!", "weight": 5, "color": "#FFAA00" },
  //   { "text": "Gradient!", "color": "#FF0000,#00FF00" },
  //   { "text": "Rainbow!", "color": "rainbow:25" },
  //   { "text": "Enjoy the weekend!", "conditions": { "weekend": true } },
